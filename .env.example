# =============================================================================
# Core Django app
# =============================================================================
# Required in any real deployment. Generate a long random secret:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# True for local development, False for staging/production.
DJANGO_DEBUG=True

# Comma-separated hosts allowed to serve the app.
# Local example:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Full HTTPS origins allowed for CSRF. Include every public domain here.
# Local development normally does not need this, but production does.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional locale overrides.
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# =============================================================================
# Database
# =============================================================================
# Preferred style: a single PostgreSQL URL.
# If this is set, the manual DB_* values below are ignored.
# Example from Vercel Postgres / Neon / Supabase / Railway:
DATABASE_URL=

# Alternative URLs also supported if your provider uses these names.
POSTGRES_URL=
POSTGRES_PRISMA_URL=

# Fallback manual DB config if you are not using DATABASE_URL.
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME=sabistore
DB_USER=sabistore
DB_PASSWORD=replace-with-db-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=

# =============================================================================
# Static, media, and storage
# =============================================================================
DJANGO_STATIC_ROOT=
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_ROOT=
DJANGO_MEDIA_URL=/media/

# Optional override. Leave empty unless you intentionally want a custom backend.
# On Vercel, the app auto-selects sabistart_store.storage_backends.VercelBlobStorage.
# Off Vercel, it auto-selects django_tenants.files.storage.TenantFileSystemStorage.
DJANGO_DEFAULT_FILE_STORAGE=

# Vercel Blob settings for persistent uploads on Vercel.
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_ACCESS=private
VERCEL_BLOB_CACHE_MAX_AGE=31536000
VERCEL_BLOB_ALLOW_OVERWRITE=True

# =============================================================================
# Domain / tenant routing
# =============================================================================
# PLATFORM_CNAME is the canonical platform domain tenants connect to.
# Example: sabistart.com or stores.yourplatform.com
PLATFORM_CNAME=localhost

# Optional suffix for generated tenant subdomains.
# Example: .sabistart.com or .stores.example.com
SUBDOMAIN_SUFFIX=

# Public server IP used by the domain-management guidance / verification flows.
SERVER_IP=127.0.0.1

# Cache lifetime for domain resolution lookups.
DOMAIN_RESOLUTION_CACHE_TTL=300

# Simulate domain infrastructure locally. Should be False in production.
DOMAIN_SIMULATE_INFRA=True

# =============================================================================
# Proxy / SSL / security
# =============================================================================
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_USE_X_FORWARDED_PORT=True
DJANGO_TRUST_X_FORWARDED_PROTO=True

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_X_FRAME_OPTIONS=SAMEORIGIN

# =============================================================================
# Email / notifications
# =============================================================================
DJANGO_DEFAULT_FROM_EMAIL=no-reply@localhost
DJANGO_SERVER_EMAIL=no-reply@localhost

# =============================================================================
# Logging
# =============================================================================
DJANGO_LOG_TO_FILE=True
DJANGO_LOG_DIR=
DJANGO_LOG_LEVEL=INFO

# =============================================================================
# Vercel-specific
# =============================================================================
# Usually injected automatically by Vercel; you normally do not set these yourself.
PUBLIC_VERCEL_URL=
VERCEL_RUN_MIGRATIONS=0
