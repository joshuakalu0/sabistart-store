# =============================================================================
# SabiStart Store - cPanel production oriented environment template
# =============================================================================
#
# Copy this file to `.env` for local/server use.
# Keep real secrets out of git.
#
# This project is designed for:
# - Django 5
# - django-tenants
# - PostgreSQL
# - cPanel Python App + Passenger
#
# The cPanel-specific production example also lives at:
# deployment/cpanel/.env.cpanel.example

# =============================================================================
# Core Django
# =============================================================================
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=sabistart.store,www.sabistart.store,.sabistart.store
DJANGO_CSRF_TRUSTED_ORIGINS=https://sabistart.store,https://www.sabistart.store,https://*.sabistart.store
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# =============================================================================
# Database
# =============================================================================
# For cPanel PostgreSQL, the manual DB_* values are usually the simplest option.
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME=cpanel_database_name
DB_USER=cpanel_database_user
DB_PASSWORD=replace-with-db-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# Optional URL-style database settings if your host provides them.
# If DATABASE_URL is set, the DB_* values above are ignored.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_PRISMA_URL=

# =============================================================================
# Static, media, and logs
# =============================================================================
# Use persistent paths on your cPanel account, not /tmp.
DJANGO_STATIC_ROOT=/home/username/sabistart-store/staticfiles
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_ROOT=/home/username/sabistart-store/media
DJANGO_MEDIA_URL=/media/
DJANGO_LOG_TO_FILE=True
DJANGO_LOG_DIR=/home/username/sabistart-store/logs
DJANGO_LOG_LEVEL=INFO

# Leave empty on cPanel so the app uses tenant filesystem storage automatically.
DJANGO_DEFAULT_FILE_STORAGE=

# =============================================================================
# Tenant domain routing
# =============================================================================
PLATFORM_CNAME=sabistart.store
SUBDOMAIN_SUFFIX=.sabistart.store
SERVER_IP=127.0.0.1
DOMAIN_RESOLUTION_CACHE_TTL=300
DOMAIN_SIMULATE_INFRA=False

# =============================================================================
# Proxy / HTTPS / security
# =============================================================================
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_USE_X_FORWARDED_PORT=True
DJANGO_TRUST_X_FORWARDED_PROTO=True

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_X_FRAME_OPTIONS=SAMEORIGIN

# =============================================================================
# Session & Cross-Subdomain Cookies
# =============================================================================
# Leave empty for standard single-domain use, or set e.g. `.sabistart.store` for wildcard cookies
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# =============================================================================
# Celery & Remote Redis Cache (Upstash / Redis)
# =============================================================================
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
REDIS_URL=

# =============================================================================
# Migration Runner Configuration
# =============================================================================
# Controls the primary migration execution engine:
# - "redis"  : local background thread with Redis progress tracking (DEFAULT)
# - "worker" : external migration worker microservice (Railway / VPS)
# - "auto"   : remote worker if MIGRATION_WORKER_URL is set, else local Redis thread
MIGRATION_RUNNER=redis

# =============================================================================
# Migration Worker Microservice (Isolated Worker Node)
# =============================================================================
# Only used when MIGRATION_RUNNER=worker or MIGRATION_RUNNER=auto with URL set.
MIGRATION_WORKER_URL=
MIGRATION_WORKER_SECRET=
MIGRATION_WEBHOOK_URL=

# =============================================================================
# Dual-Engine Migration Runner & Watchdog Settings
# =============================================================================
ENABLE_CELERY_MIGRATIONS=False
CELERY_MIGRATION_STALL_TIMEOUT=40
TENANT_MIGRATION_BACKOFF_TIMEOUT=15

TENANT_PROVISIONING_CHUNK_SIZE=1
TENANT_PROVISIONING_HEAL_BUDGET=8
TENANT_PROVISIONING_POLL_BUDGET=6
TENANT_PROVISIONING_ADMIN_RETRY_BUDGET=20
TENANT_PROVISIONING_FAIL_COOLDOWN=60



# =============================================================================
# Email
# =============================================================================
DJANGO_DEFAULT_FROM_EMAIL=no-reply@sabistart.store
DJANGO_SERVER_EMAIL=no-reply@sabistart.store

# =============================================================================
# Optional legacy Vercel-only settings
# =============================================================================
# Ignore these on cPanel unless you intentionally still use Vercel somewhere.
DATABASE_URL_UNPOOLED=
PUBLIC_VERCEL_URL=
VERCEL_RUN_MIGRATIONS=0
VERCEL_BOOTSTRAP_PUBLIC_DOMAIN=0
VERCEL_BOOTSTRAP_PUBLIC_DOMAIN_REASSIGN=0
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_ACCESS=private
VERCEL_BLOB_CACHE_MAX_AGE=31536000
VERCEL_BLOB_ALLOW_OVERWRITE=True

