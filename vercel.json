{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash deployment/vercel/build.sh",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{public/**,dashboard/**,system/**,templates/**,themes/**,sabistart_store/**,runtime_packages/**}"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
