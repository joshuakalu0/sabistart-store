{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash deployment/vercel/build.sh",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
